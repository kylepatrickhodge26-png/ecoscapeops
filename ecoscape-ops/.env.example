# Copy to .env.local and fill in.
#
# Local development: run `npx supabase start`, then `npx supabase status` and copy the
# API URL and the publishable key here.
# Hosted Supabase: Project Settings -> API (or "Connect") -> Project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Weather forecast (optional; server-only, never NEXT_PUBLIC_). See README.md,
# "Setting up the forecast".
# OPENWEATHER_API_KEY=
